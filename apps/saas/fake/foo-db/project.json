{
  "name": "saas-fake-foo-db",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/saas/fake/foo-db/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/saas/fake/foo-db"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../../../coverage/apps/saas/fake/foo-db"
      }
    },
    "db:seed": {
      "command": "tsx src/lib/seed/seed.ts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "db:reset": {
      "command": "tsx src/lib/seed/reset.ts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "db:mig:apply": {
      "command": "drizzle-kit migrate",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "db:mig:gen": {
      "command": "drizzle-kit generate",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "db:mig:gen:c": {
      "command": "drizzle-kit generate --custom --name {args.name}",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "db:push": {
      "command": "drizzle-kit push",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "db:pull": {
      "command": "drizzle-kit pull",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
