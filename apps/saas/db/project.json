{
  "name": "saas-db",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/saas/db/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "seed": {
      "command": "tsx src/lib/seed/seed.ts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },

    "introspect": {
      "command": "tsx src/lib/introspect.ts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },

    "reset": {
      "command": "tsx src/lib/seed/reset.ts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "mig:apply": {
      "command": "drizzle-kit migrate",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "mig:gen": {
      "command": "drizzle-kit generate",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "mig:gen:c": {
      "command": "drizzle-kit generate --custom --name {args.name}",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "push": {
      "command": "drizzle-kit push",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "pull": {
      "command": "drizzle-kit pull",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../../coverage/apps/saas/db"
      }
    }
  }
}
