{
  "name": "saas-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/saas/core/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/saas/core",
        "main": "apps/saas/core/src/index.ts",
        "tsConfig": "apps/saas/core/tsconfig.lib.json",
        "assets": [],
        "format": ["cjs"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../../coverage/apps/saas/core"
      }
    }
  }
}
