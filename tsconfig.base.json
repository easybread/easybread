{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "strict": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2024",
    "module": "esnext",
    "lib": ["ES2024", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "paths": {
      "@easybread/adapter-bamboo-hr": [
        "packages/service-adapters/bamboo-hr/src/index.ts"
      ],
      "@easybread/adapter-breezy": [
        "packages/service-adapters/breezy/src/index.ts"
      ],
      "@easybread/adapter-google-admin-directory": [
        "packages/service-adapters/google/admin-directory/src/index.ts"
      ],
      "@easybread/adapter-google-common": [
        "packages/service-adapters/google/common/src/index.ts"
      ],
      "@easybread/adapter-google-contacts": [
        "packages/service-adapters/google/contacts/src/index.ts"
      ],
      "@easybread/adapter-rocket-chat-common": [
        "packages/service-adapters/rocket-chat/common/src/index.ts"
      ],
      "@easybread/adapter-rocket-chat-users": [
        "packages/service-adapters/rocket-chat/users/src/index.ts"
      ],
      "@easybread/commands": ["packages/commands/src/index.ts"],
      "@easybread/common": ["packages/common/src/index.ts"],
      "@easybread/core": ["packages/core/src/index.ts"],
      "@easybread/data-adapter": ["packages/data-adapter/src/index.ts"],
      "@easybread/data-mapper": ["packages/data-mapper/src/index.ts"],
      "@easybread/pagination-adapter": [
        "packages/pagination-adapter/src/index.ts"
      ],
      "@easybread/recommended": ["tools/recommended/src/index.ts"],
      "@easybread/schemas": ["packages/schemas/src/index.ts"],
      "@easybread/state-adapter-mongo": [
        "packages/state-adapter-mongo/src/index.ts"
      ],
      "@easybread/test-utils": ["packages/test-utils/src/index.ts"],
      "playground-common": ["playground/common/src/index.ts"],
      "playground-db": ["playground/db/src/index.ts"],
      "playground-easybread-clients": [
        "playground/easybread/clients/src/index.ts"
      ],
      "playground-easybread-state": ["playground/easybread/state/src/index.ts"],
      "playground-feat-adapters-actions": [
        "playground/feat/adapters/actions/src/index.ts"
      ],
      "playground-feat-adapters-data": [
        "playground/feat/adapters/data/src/index.ts"
      ],
      "playground-feat-adapters-ui": [
        "playground/feat/adapters/ui/src/index.ts"
      ],
      "playground-feat-adapters-ui/server": [
        "playground/feat/adapters/ui/src/server.ts"
      ],
      "playground-feat-auth-actions": [
        "playground/feat/auth/actions/src/index.ts"
      ],
      "playground-feat-auth-data": ["playground/feat/auth/data/src/index.ts"],
      "playground-feat-auth-ui": ["playground/feat/auth/ui/src/index.ts"],
      "playground-feat-auth-ui/server": [
        "playground/feat/auth/ui/src/server.ts"
      ],
      "playground-feat-nav-ui": ["playground/feat/nav/ui/src/index.ts"],
      "playground-feat-nav-ui/server": ["playground/feat/nav/ui/src/server.ts"],
      "playground-feat-people-data": [
        "playground/feat/people/data/src/index.ts"
      ],
      "playground-feat-people-ui": ["playground/feat/people/ui/src/index.ts"],
      "playground-feat-people-ui/server": [
        "playground/feat/people/ui/src/server.ts"
      ],
      "playground-feat-users-data": ["playground/feat/users/data/src/index.ts"],
      "playground-ui": ["playground/ui/src/index.ts"],
      "saas-auth": ["apps/saas/auth/src/index.ts"],
      "saas-auth/server": ["apps/saas/auth/src/server.ts"],
      "saas-core": ["apps/saas/core/src/index.ts"],
      "saas-dto": ["apps/saas/dto/src/index.ts"],
      "saas-errors": ["apps/saas/errors/src/index.ts"],
      "saas-neverthrow-util": ["apps/saas/neverthrow-util/src/index.ts"],
      "saas-pg": ["apps/saas/pg/src/index.ts"],
      "saas-pg/enums": ["apps/saas/pg/src/lib/enums/index.ts"],
      "saas-pg/types": ["apps/saas/pg/src/lib/types.ts"],
      "saas-redis": ["apps/saas/redis/src/index.ts"],
      "saas-trpc": ["apps/saas/trpc/src/index.ts"],
      "saas-trpc/server": ["apps/saas/trpc/src/server.ts"],
      "saas-ui": ["apps/saas/ui/src/index.ts"],
      "saas-ui/*": ["apps/saas/ui/src/*"]
